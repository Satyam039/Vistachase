# ==============================================================================
# Vista Chase Frontend (Next.js) - Environment Configuration
# ==============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# SEO (docs/SEO.md). SITE_URL is the public address used in sitemap.xml, robots.txt, llms.txt and
# JSON-LD (falls back to NEXT_PUBLIC_APP_URL). SEO_BLOCK_INDEXING=true makes robots.txt
# "Disallow: /" (staging, or while the site is still on a bare IP).
SITE_URL=
SEO_BLOCK_INDEXING=false

# Where the Express backend is reachable from the Next.js server.
# Used by server components and by the /api/* rewrite (read at build time).
BACKEND_URL=http://localhost:4000

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPS_API_KEY=

# Error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
