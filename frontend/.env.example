# ==============================================================================
# Vista Chase Frontend (Next.js) - Environment Configuration
# ==============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# SEO (docs/SEO.md). SITE_URL is the public address used in sitemap.xml, robots.txt, llms.txt and
# JSON-LD (falls back to NEXT_PUBLIC_APP_URL). SEO_BLOCK_INDEXING=true makes robots.txt
# "Disallow: /" (staging, or while the site is still on a bare IP).
SITE_URL=
SEO_BLOCK_INDEXING=false

# Where the Express backend is reachable from the Next.js server.
# Used by server components and by the /api/* rewrite (read at build time).
BACKEND_URL=http://localhost:4000

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPS_API_KEY=

# Error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Optional real-time live chat for the concierge's "Chat with a live agent" (Crisp website ID,
# from crisp.chat). Unset: the conversation is emailed to the support team instead.
NEXT_PUBLIC_CRISP_WEBSITE_ID=
# Optional Cloudflare Turnstile spam check on the contact form (backend needs TURNSTILE_SECRET_KEY).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Activity tickets are hidden from guests. Set to true (and rebuild) to show the menu links, home
# cards and /banff-activity-tickets again. Set SHOW_ACTIVITY_TICKETS=true in backend/.env too so
# the concierge mentions them.
NEXT_PUBLIC_SHOW_ACTIVITY_TICKETS=false
