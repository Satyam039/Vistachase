{
  "name": "vistachase-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Vista Chase - Next.js customer site, checkout, account and admin UI",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
