    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/montserrat-alternates": "^5.3.0",
    "@stylexjs/stylex": "^0.19.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.3.0",
