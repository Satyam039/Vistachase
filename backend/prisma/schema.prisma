datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         String     @default("CUSTOMER") // ADMIN, OPERATOR, DISPATCHER, CUSTOMER, AFFILIATE
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookings     Booking[]
  auditLogs    AuditLog[]
  affiliate    Affiliate?

  @@index([email])
}

model Destination {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  province        String   @default("Alberta")
  region          String   @default("Canadian Rockies")
  description     String
  heroImage       String
  isFeatured      Boolean  @default(false)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  tours           Tour[]

  @@index([slug])
}

model Tour {
  id              String          @id @default(cuid())
  slug            String          @unique
  bokunId         String?         @unique // Bokun experience ID, from prisma/catalog/product-map.json (null until provided)
  title           String
  category        String          @default("SHARED") // SHARED, PRIVATE, SHUTTLE, MULTIDAY
  durationHours   Float
  summary         String
  description     String
  inclusions      String // JSON array string
  exclusions      String // JSON array string
  highlights      String // JSON array string
  whatToBring     String // JSON array string
  featuredImage   String
  galleryImages   String // JSON array string
  basePrice       Float
  currency        String          @default("CAD")
  minGroupSize    Int             @default(1)
  maxGroupSize    Int             @default(14)
  isFeatured      Boolean         @default(false)
  rating          Float           @default(5.0)
  reviewCount     Int             @default(0)
  // Catalog content imported from the live site (backend/prisma/catalog/products.json)
  bookingMode     String          @default("BOKUN") // BOKUN (instant booking), ENQUIRY (request form)
  priceUnit       String          @default("PERSON") // PERSON, GROUP (whole vehicle)
  facts           String          @default("[]") // JSON [{label, value}]
  tabs            String          @default("[]") // JSON [{label, sections: [{heading, body[], items[], steps[{time,text}], note}]}]
  faqs            String          @default("[]") // JSON [{question, answer}]
  crossSells      String          @default("[]") // JSON array of tour slugs
  vehicleOptions  String          @default("[]") // JSON [{id, label, seats}] for PRIVATE / MULTIDAY
  sortOrder       Int             @default(0)
  metaTitle       String?
  metaDescription String?
  destinationId   String
  destination     Destination     @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  departures      TourDeparture[]
  reviews         Review[]

  @@index([slug])
  @@index([bokunId])
  @@index([category])
  @@index([destinationId])
}

model ShuttleRoute {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  origin      String
  destination String
  isReturn    Boolean         @default(true)
  description String
  notes       String?
  departures  TourDeparture[]

  @@index([slug])
}

model ShuttleStop {
  id           String    @id @default(cuid())
  name         String
  town         String // Banff, Canmore, Lake Louise, Calgary
  address      String
  latitude     Float
  longitude    Float
  instructions String
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  bookings     Booking[]

  @@index([town])
}

model TourDeparture {
  id             String            @id @default(cuid())
  tourId         String?
  tour           Tour?             @relation(fields: [tourId], references: [id], onDelete: Cascade)
  shuttleRouteId String?
  shuttleRoute   ShuttleRoute?     @relation(fields: [shuttleRouteId], references: [id], onDelete: Cascade)
  date           String // YYYY-MM-DD
  departureTime  String // e.g. "05:00", "08:30"
  returnTime     String? // e.g. "10:30", "16:30"
  capacityTotal  Int               @default(14)
  capacityBooked Int               @default(0)
  capacityHeld   Int               @default(0)
  price          Float
  currency       String            @default("CAD")
  status         String            @default("ACTIVE") // ACTIVE, FULL, CANCELLED
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  holds          ReservationHold[]
  bookings       Booking[]
  operationRuns  OperationRun[]

  @@index([date])
  @@index([tourId])
  @@index([shuttleRouteId])
}

model ReservationHold {
  id              String        @id @default(cuid())
  holdToken       String        @unique
  tourDepartureId String
  tourDeparture   TourDeparture @relation(fields: [tourDepartureId], references: [id], onDelete: Cascade)
  seatsCount      Int
  customerName    String
  customerEmail   String
  customerPhone   String?
  expiresAt       DateTime
  status          String        @default("ACTIVE") // ACTIVE, EXPIRED, CONVERTED, RELEASED
  createdAt       DateTime      @default(now())

  @@index([holdToken])
  @@index([expiresAt])
}

model Booking {
  id                     String                 @id @default(cuid())
  bookingReference       String                 @unique // e.g. VC-2026-89412
  affiliateId            String? // partner whose ?ref= link brought this booking
  affiliate              Affiliate?             @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  bokunBookingId         String?                @unique // Bókun external confirmation reference
  customerId             String?
  customer               User?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName           String
  customerEmail          String
  customerPhone          String
  tourDepartureId        String
  tourDeparture          TourDeparture          @relation(fields: [tourDepartureId], references: [id], onDelete: Restrict)
  pickupStopId           String?
  pickupStop             ShuttleStop?           @relation(fields: [pickupStopId], references: [id], onDelete: SetNull)
  pickupCustomText       String?
  pickupTime             String?
  adultsCount            Int                    @default(1)
  childrenCount          Int                    @default(0)
  infantsCount           Int                    @default(0)
  totalSeats             Int
  subtotal               Float
  tax                    Float                  @default(0.0)
  addOnsTotal            Float                  @default(0.0)
  totalAmount            Float
  currency               String                 @default("CAD")
  status                 String                 @default("CONFIRMED") // CONFIRMED, PENDING_PAYMENT, CANCELLED, COMPLETED
  specialRequests        String?
  voucherCode            String                 @unique
  qrCodeUrl              String?
  trackingToken          String?                @unique // 64-character unguessable crypto hex string
  trackingTokenExpiresAt DateTime?
  isBoarded              Boolean                @default(false)
  boardedAt              DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  items                  BookingAddOn[]
  payments               Payment[]
  review                 Review?
  runBookings            RunBooking[]
  whatsappNotifications  WhatsAppNotification[]

  @@index([bookingReference])
  @@index([affiliateId])
  @@index([bokunBookingId])
  @@index([trackingToken])
  @@index([customerEmail])
  @@index([voucherCode])
}

model BookingAddOn {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  price     Float
  quantity  Int     @default(1)
}

model Payment {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String   @default("CAD")
  provider      String // mock, stripe
  transactionId String   @unique
  status        String // SUCCEEDED, PENDING, REFUNDED
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([bookingId])
}

model Review {
  id         String   @id @default(cuid())
  tourId     String
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookingId  String?  @unique
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int      @default(5)
  title      String
  body       String
  isVerified Boolean  @default(true)
  isFeatured Boolean  @default(false)
  date       String
  createdAt  DateTime @default(now())

  @@index([tourId])
}

// ---------------------------------------------------------------------------
// Mornby Operations Platform Models: Fleet, Drivers, Runs & Routing
// ---------------------------------------------------------------------------

model Vehicle {
  id               String            @id @default(cuid())
  name             String // e.g. "Mercedes-Benz Sprinter Executive #4"
  type             String            @default("VAN_14") // VAN_14, SUV_6, COACH_24
  capacity         Int               @default(14)
  licensePlate     String            @unique // e.g. "ALBERTA • 7VC-894"
  vinNumber        String?
  trackingDeviceId String?           @unique
  isActive         Boolean           @default(true)
  status           String            @default("AVAILABLE") // AVAILABLE, ASSIGNED, IN_SERVICE, MAINTENANCE
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  runs             OperationRun[]
  positions        VehiclePosition[]

  @@index([licensePlate])
}

model Driver {
  id           String         @id @default(cuid())
  name         String // Legal full name (internal operations)
  publicName   String // Customer-visible name (e.g. "Marc")
  email        String         @unique
  phone        String // Internal contact phone
  licenseClass String         @default("Class 4")
  bio          String?
  photoUrl     String?
  rating       Float          @default(5.0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  runs         OperationRun[]

  @@index([email])
}

model OperationRun {
  id              String           @id @default(cuid())
  name            String // e.g. "Run 1 - Morning Lake Louise Express"
  date            String // YYYY-MM-DD
  departureTime   String? // e.g. "05:00"
  tourDepartureId String
  tourDeparture   TourDeparture    @relation(fields: [tourDepartureId], references: [id], onDelete: Cascade)
  vehicleId       String?
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId        String?
  driver          Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status          String           @default("PLANNED") // PLANNED, READY, DISPATCHED, BOARDING, IN_PROGRESS, COMPLETED, CANCELLED, DELAYED
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bookings        RunBooking[]
  trackingSession TrackingSession?

  @@index([date])
  @@index([status])
  @@index([tourDepartureId])
}

model RunBooking {
  id          String       @id @default(cuid())
  runId       String
  run         OperationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  bookingId   String
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pickupOrder Int          @default(0) // Sequence order (1, 2, 3...)
  isBoarded   Boolean      @default(false)
  boardedAt   DateTime?
  notes       String?

  @@unique([runId, bookingId])
  @@index([runId])
  @@index([bookingId])
}

model TrackingSession {
  id        String       @id @default(cuid())
  runId     String       @unique
  run       OperationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  token     String       @unique // 64-char crypto hex string
  isActive  Boolean      @default(true)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([token])
}

model VehiclePosition {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  heading   Float    @default(0)
  speedKmh  Float    @default(0)
  timestamp DateTime @default(now())

  @@index([vehicleId, timestamp])
}

model WhatsAppNotification {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type         String   @default("T_60_TRACKING")
  phone        String
  messageId    String?
  status       String   @default("SENT") // SENT, FAILED, DELIVERED
  dispatchedAt DateTime @default(now())

  @@unique([bookingId, type]) // Strict Idempotency Guarantee
  @@index([bookingId])
}

model BokunSyncLog {
  id            String   @id @default(cuid())
  syncType      String // "POLL", "WEBHOOK", "CSV_IMPORT"
  recordsSynced Int      @default(0)
  status        String   @default("SUCCESS")
  details       String? // JSON or error log
  createdAt     DateTime @default(now())
}

model MediaAsset {
  id        String   @id @default(cuid())
  title     String
  url       String
  folder    String   @default("tours")
  altText   String?
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "HOLD_CREATED", "CAPACITY_OVERRIDE", "BOOKING_REFUNDED"
  entityType String // "Booking", "TourDeparture", "User"
  entityId   String
  details    String // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Partner program: hotels, agents and creators who refer bookings with their ?ref= link.
// Each partner maps to a Bokun booking channel once Vista Chase's Bokun API access exists.
model Affiliate {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code           String    @unique // referral code used in ?ref=CODE links
  name           String // business or creator name
  type           String    @default("HOTEL") // HOTEL, AGENT, CREATOR, OTHER
  website        String?
  status         String    @default("PENDING") // PENDING, ACTIVE, SUSPENDED
  commissionRate Float     @default(0.1)
  bokunChannelId String? // Bokun booking channel for this partner (placeholder until API access)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]

  @@index([status])
}

// Messages from the contact form and "Request this tour" (custom quotes). The team is emailed a
// copy; the record keeps it if email delivery fails.
model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  tourSlug  String?
  guests    Int?
  date      String?
  message   String
  status    String   @default("NEW") // NEW | REPLIED | CLOSED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}
