datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERATOR
  DISPATCHER
  CUSTOMER
  AFFILIATE
  SEO_MANAGER // SEO workspace: keywords, page metadata, redirects, audits, llms.txt; no bookings or payments
  EDITOR // site content: tour and destination copy, page content fields; no SEO configuration
  VIEWER // read-only SEO workspace and content
}

enum BookingStatus {
  CONFIRMED
  PENDING_PAYMENT
  CANCELLED
  REFUNDED
  COMPLETED
  PAID_UNSYNCED
  EXPIRED // payment window passed before the guest paid; seats released
}

enum HoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  RELEASED
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  IN_SERVICE
  MAINTENANCE
}

enum RunStatus {
  PLANNED
  READY
  DISPATCHED
  BOARDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELAYED
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum EnquiryStatus {
  NEW
  REPLIED
  CLOSED
}

// How the guest chose to pay (docs/DEPOSITS.md): everything at checkout, or a 20% deposit with the
// balance due 7 days before departure.
enum PaymentPlan {
  FULL
  DEPOSIT
}

// What a payment row pays for.
enum PaymentKind {
  FULL
  DEPOSIT
  BALANCE
}

enum PaymentStatus {
  SUCCEEDED
  PENDING
  REFUNDED
  FAILED
}

enum TourCategory {
  SHARED
  PRIVATE
  SHUTTLE
  MULTIDAY
  TICKET
}

enum TourBookingMode {
  BOKUN
  ENQUIRY
}

enum TourPriceUnit {
  PERSON
  GROUP
}

// Where a departure's date, seats and price come from. Only LOCAL is sold online today.
enum InventorySource {
  LOCAL // entered or confirmed by Vista Chase staff: this database is authoritative
  EXTERNAL // synced from a provider such as Bókun (no sync exists yet, so not sold)
  UNVERIFIED // seeded or unknown: shown to no one and never sold until staff confirm it
}

// Future provider sync (outbox). Nothing writes these yet; see docs/BOOKING_ENGINE.md.
enum ExternalSyncStatus {
  NOT_REQUIRED
  PENDING
  SYNCED
  FAILED
}

enum SyncTaskStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  RETRYABLE_FAILURE
  FAILED
  SKIPPED
}

enum DepartureStatus {
  ACTIVE
  FULL
  CANCELLED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  name                String
  phone               String?
  role                Role       @default(CUSTOMER) // see enum Role
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  emailVerified       Boolean    @default(false)
  verificationToken   String?
  resetToken          String?
  resetTokenExpiry    DateTime?
  sessionsValidAfter  DateTime? // sign-ins issued before this are refused (password reset, made staff)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  bookings            Booking[]
  auditLogs           AuditLog[]
  affiliate           Affiliate?

  @@index([email])
}

model Destination {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  province        String   @default("Alberta")
  region          String   @default("Canadian Rockies")
  description     String
  heroImage       String
  isFeatured      Boolean  @default(false)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  tours           Tour[]
  seoPage         SeoPage?

  @@index([slug])
}

model Tour {
  id              String          @id @default(cuid())
  slug            String          @unique
  bokunId         String?         @unique // Bokun experience ID, from prisma/catalog/product-map.json (null until provided)
  title           String
  category        TourCategory    @default(SHARED) // SHARED, PRIVATE, SHUTTLE, MULTIDAY
  durationHours   Float
  summary         String
  description     String
  inclusions      Json // JSON array string
  exclusions      Json // JSON array string
  highlights      Json // JSON array string
  whatToBring     Json // JSON array string
  featuredImage   String
  galleryImages   Json // JSON array string
  basePrice       Int
  currency        String          @default("CAD")
  minGroupSize    Int             @default(1)
  maxGroupSize    Int             @default(14)
  isFeatured      Boolean         @default(false)
  rating          Float           @default(5.0)
  reviewCount     Int             @default(0)
  // Catalog content imported from the live site (backend/prisma/catalog/products.json)
  bookingMode     TourBookingMode @default(BOKUN) // BOKUN (instant booking), ENQUIRY (request form)
  priceUnit       TourPriceUnit   @default(PERSON) // PERSON, GROUP (whole vehicle)
  facts           Json            @default("[]") // JSON [{label, value}]
  tabs            Json            @default("[]") // JSON [{label, sections: [{heading, body[], items[], steps[{time,text}], note}]}]
  faqs            Json            @default("[]") // JSON [{question, answer}]
  crossSells      Json            @default("[]") // JSON array of tour slugs
  vehicleOptions  Json            @default("[]") // JSON [{id, label, seats}] for PRIVATE / MULTIDAY
  sortOrder       Int             @default(0)
  metaTitle       String?
  metaDescription String?
  destinationId   String
  destination     Destination     @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  departures      TourDeparture[]
  reviews         Review[]
  seoPage         SeoPage?

  @@index([slug])
  @@index([bokunId])
  @@index([category])
  @@index([destinationId])
}

model ShuttleRoute {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  origin      String
  destination String
  isReturn    Boolean         @default(true)
  description String
  notes       String?
  departures  TourDeparture[]

  @@index([slug])
}

model ShuttleStop {
  id           String    @id @default(cuid())
  name         String
  town         String // Banff, Canmore, Lake Louise, Calgary
  address      String
  latitude     Float
  longitude    Float
  instructions String
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  bookings     Booking[]

  @@index([town])
}

model TourDeparture {
  id                  String            @id @default(cuid())
  tourId              String?
  tour                Tour?             @relation(fields: [tourId], references: [id], onDelete: Cascade)
  shuttleRouteId      String?
  shuttleRoute        ShuttleRoute?     @relation(fields: [shuttleRouteId], references: [id], onDelete: Cascade)
  date                DateTime // YYYY-MM-DD
  departureTime       DateTime // e.g. "05:00", "08:30"
  returnTime          DateTime? // e.g. "10:30", "16:30"
  capacityTotal       Int               @default(14)
  capacityBooked      Int               @default(0)
  capacityHeld        Int               @default(0)
  price               Int // cents: per guest (adult), or per vehicle for private tours
  childPrice          Int? // cents per child, when Bókun prices children differently
  currency            String            @default("CAD")
  status              DepartureStatus   @default(ACTIVE) // ACTIVE, FULL, CANCELLED
  inventorySource     InventorySource   @default(UNVERIFIED)
  inventoryVerifiedAt DateTime? // when staff confirmed it (LOCAL) or a provider last synced it (EXTERNAL)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  holds               ReservationHold[]
  bookings            Booking[]
  operationRuns       OperationRun[]

  @@index([date])
  @@index([tourId])
  @@index([shuttleRouteId])
}

model ReservationHold {
  id              String        @id @default(cuid())
  holdToken       String        @unique
  tourDepartureId String
  tourDeparture   TourDeparture @relation(fields: [tourDepartureId], references: [id], onDelete: Cascade)
  seatsCount      Int
  customerName    String
  customerEmail   String
  customerPhone   String?
  expiresAt       DateTime
  status          HoldStatus    @default(ACTIVE) // ACTIVE, EXPIRED, CONVERTED, RELEASED
  bookingId       String?       @unique // the booking this hold became (CONVERTED)
  createdAt       DateTime      @default(now())

  @@index([holdToken])
  @@index([expiresAt])
}

model Booking {
  id                      String                 @id @default(cuid())
  bookingReference        String                 @unique // e.g. VC-2026-89412
  affiliateId             String? // partner whose ?ref= link brought this booking
  affiliate               Affiliate?             @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  bokunBookingId          String?                @unique // Bókun external confirmation reference
  adminNotes              String? // Staff-only notes (admin booking screen)
  reviewRequestedAt       DateTime? // When the post-trip review email went out (sent once)
  confirmationEmailSentAt DateTime? // When the confirmation email + PDF itinerary went out (claimed once; cleared if the send failed)
  confirmationEmailError  String? // Why the last confirmation email failed (retried by the jobs runner)
  customerId              String?
  customer                User?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName            String
  customerEmail           String
  customerPhone           String
  tourDepartureId         String
  tourDeparture           TourDeparture          @relation(fields: [tourDepartureId], references: [id], onDelete: Restrict)
  pickupStopId            String?
  pickupStop              ShuttleStop?           @relation(fields: [pickupStopId], references: [id], onDelete: SetNull)
  pickupCustomText        String?
  pickupTime              String?
  adultsCount             Int                    @default(1)
  childrenCount           Int                    @default(0)
  infantsCount            Int                    @default(0)
  totalSeats              Int
  subtotal                Int
  tax                     Int                    @default(0)
  addOnsTotal             Int                    @default(0)
  totalAmount             Int
  currency                String                 @default("CAD")
  status                  BookingStatus          @default(CONFIRMED) // CONFIRMED, PENDING_PAYMENT, CANCELLED, EXPIRED, REFUNDED, COMPLETED
  idempotencyKey          String?                @unique // client key: a retried submission returns this booking
  priceSnapshot           Json? // what the server priced it with (unit prices, promo, add-ons, totals)
  paymentExpiresAt        DateTime? // unpaid after this: EXPIRED and seats released
  paymentPlan             PaymentPlan            @default(FULL)
  depositAmount           Int? // DEPOSIT plan: cents paid at checkout (non-refundable)
  balanceDueAt            DateTime? // DEPOSIT plan: the rest is due by this instant
  balancePaidAt           DateTime? // DEPOSIT plan: when the rest was paid
  balanceReminderStage    Int                    @default(0) // 1 reminder sent, 2 due-day notice, 3 overdue (staff flagged)
  externalSyncStatus      ExternalSyncStatus     @default(NOT_REQUIRED)
  lastSyncAttemptAt       DateTime?
  specialRequests         String?
  voucherCode             String                 @unique
  qrCodeUrl               String?
  trackingToken           String?                @unique // 64-character unguessable crypto hex string
  trackingTokenExpiresAt  DateTime?
  isBoarded               Boolean                @default(false)
  boardedAt               DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  items                   BookingAddOn[]
  payments                Payment[]
  review                  Review?
  runBookings             RunBooking[]
  whatsappNotifications   WhatsAppNotification[]
  syncTasks               BookingSyncTask[]
  commissions             CommissionLedger[]
  flags                   BookingFlag[]

  @@index([bookingReference])
  @@index([affiliateId])
  @@index([bokunBookingId])
  @@index([trackingToken])
  @@index([customerEmail])
  @@index([voucherCode])
  @@index([customerId])
  @@index([tourDepartureId, status])
  @@index([status, paymentExpiresAt])
  @@index([paymentPlan, status])
}

model BookingAddOn {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  quantity  Int     @default(1)
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount        Int
  currency      String        @default("CAD")
  provider      String // mock, stripe
  transactionId String        @unique
  kind          PaymentKind   @default(FULL)
  status        PaymentStatus
  createdAt     DateTime      @default(now())

  @@index([transactionId])
  @@index([bookingId])
}

model Review {
  id         String   @id @default(cuid())
  tourId     String
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookingId  String?  @unique
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int      @default(5)
  title      String
  body       String
  isVerified Boolean  @default(true)
  isFeatured Boolean  @default(false)
  date       DateTime
  createdAt  DateTime @default(now())

  @@index([tourId])
}

// ---------------------------------------------------------------------------
// Mornby Operations Platform Models: Fleet, Drivers, Runs & Routing
// ---------------------------------------------------------------------------

model Vehicle {
  id               String            @id @default(cuid())
  name             String // e.g. "Mercedes-Benz Sprinter Executive #4"
  type             String            @default("VAN_14") // VAN_14, SUV_6, COACH_24
  capacity         Int               @default(14)
  licensePlate     String            @unique // e.g. "ALBERTA • 7VC-894"
  vinNumber        String?
  trackingDeviceId String?           @unique
  isActive         Boolean           @default(true)
  status           VehicleStatus     @default(AVAILABLE) // AVAILABLE, ASSIGNED, IN_SERVICE, MAINTENANCE
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  runs             OperationRun[]
  positions        VehiclePosition[]

  @@index([licensePlate])
}

model Driver {
  id           String         @id @default(cuid())
  name         String // Legal full name (internal operations)
  publicName   String // Customer-visible name (e.g. "Marc")
  email        String         @unique
  phone        String // Internal contact phone
  licenseClass String         @default("Class 4")
  bio          String?
  photoUrl     String?
  rating       Float          @default(5.0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  runs         OperationRun[]

  @@index([email])
}

model OperationRun {
  id              String           @id @default(cuid())
  name            String // e.g. "Run 1 - Morning Lake Louise Express"
  date            DateTime // YYYY-MM-DD
  departureTime   DateTime? // e.g. "05:00"
  tourDepartureId String
  tourDeparture   TourDeparture    @relation(fields: [tourDepartureId], references: [id], onDelete: Cascade)
  vehicleId       String?
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId        String?
  driver          Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status          RunStatus        @default(PLANNED) // PLANNED, READY, DISPATCHED, BOARDING, IN_PROGRESS, COMPLETED, CANCELLED, DELAYED
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bookings        RunBooking[]
  trackingSession TrackingSession?

  @@index([date])
  @@index([status])
  @@index([tourDepartureId])
}

model RunBooking {
  id          String       @id @default(cuid())
  runId       String
  run         OperationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  bookingId   String
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pickupOrder Int          @default(0) // Sequence order (1, 2, 3...)
  isBoarded   Boolean      @default(false)
  boardedAt   DateTime?
  notes       String?

  @@unique([runId, bookingId])
  @@index([runId])
  @@index([bookingId])
}

model TrackingSession {
  id        String       @id @default(cuid())
  runId     String       @unique
  run       OperationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  token     String       @unique // 64-char crypto hex string
  isActive  Boolean      @default(true)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([token])
}

model VehiclePosition {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  heading   Float    @default(0)
  speedKmh  Float    @default(0)
  timestamp DateTime @default(now())

  @@index([vehicleId, timestamp])
}

model WhatsAppNotification {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type         String   @default("T_60_TRACKING")
  phone        String
  messageId    String?
  status       String   @default("SENT") // SENT, FAILED, DELIVERED
  dispatchedAt DateTime @default(now())

  @@unique([bookingId, type]) // Strict Idempotency Guarantee
  @@index([bookingId])
}

model BokunSyncLog {
  id            String   @id @default(cuid())
  syncType      String // "POLL", "WEBHOOK", "CSV_IMPORT"
  recordsSynced Int      @default(0)
  status        String   @default("SUCCESS")
  details       Json? // JSON or error log
  createdAt     DateTime @default(now())
}

// Outbox for a future provider sync (Bókun). One row per booking change to send; the unique
// idempotencyKey (provider:booking:operation:version) stops duplicates. Nothing writes or sends
// these until a separate, approved integration phase.
model BookingSyncTask {
  id             String         @id @default(cuid())
  bookingId      String
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  provider       String // "BOKUN"
  operation      String // CREATE, CANCEL, AMEND
  idempotencyKey String         @unique
  status         SyncTaskStatus @default(PENDING)
  attempts       Int            @default(0)
  nextAttemptAt  DateTime       @default(now())
  lastAttemptAt  DateTime?
  lastError      String?
  externalRef    String? // provider booking / reservation reference once known
  payload        Json? // snapshot of what was (to be) sent
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([bookingId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  title     String
  url       String
  folder    String   @default("tours")
  altText   String?
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "HOLD_CREATED", "CAPACITY_OVERRIDE", "BOOKING_REFUNDED"
  entityType String // "Booking", "TourDeparture", "User"
  entityId   String
  details    Json // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Partner program: hotels, agents and creators who refer bookings with their ?ref= link.
// Each partner maps to a Bokun booking channel once Vista Chase's Bokun API access exists.
model Affiliate {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  code            String             @unique // referral code used in ?ref=CODE links
  name            String // business or creator name
  type            String             @default("HOTEL") // HOTEL, AGENT, CREATOR, OTHER
  website         String?
  status          AffiliateStatus    @default(PENDING) // PENDING, ACTIVE, SUSPENDED
  commissionRate  Float              @default(0.1)
  bokunChannelId  String? // Bokun booking channel for this partner (placeholder until API access)
  phone           String?
  payoutEmail     String? // where Vista Chase sends the partner's payouts (paid outside the app)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  bookings        Booking[]
  commissionRules CommissionRule[]
  commissions     CommissionLedger[]
  payouts         AffiliatePayout[]
  clicks          AffiliateClick[]

  @@index([status])
}

// Messages from the contact form and "Request this tour" (custom quotes). The team is emailed a
// copy; the record keeps it if email delivery fails.
model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  tourSlug  String?
  guests    Int?
  date      DateTime?
  message   String
  status    EnquiryStatus @default(NEW) // NEW | REPLIED | CLOSED
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------------------------
// Partner commissions (docs/AFFILIATE_PLATFORM_DESIGN.md). Money is integer cents, CAD.

enum CommissionEntryType {
  EARNED // the booking's payment was verified
  REVERSAL // part or all of the booking was refunded (negative amount)
  ADJUSTMENT // staff correction, reason required (either sign)
}

enum CommissionStatus {
  PENDING // the tour hasn't run yet
  APPROVED // payable: the tour date has passed, or approved by an admin
  PAID // included in a payout an admin marked paid
}

enum PayoutStatus {
  DRAFT
  PAID
  CANCELLED
}

/// What a partner earns. The most specific active rule wins: partner + tour, partner + category,
/// partner, then the same three for everyone (affiliateId null). With no rule, the partner's
/// commissionRate applies. Exactly one of percentBps (1000 = 10%) or fixedCents is set.
model CommissionRule {
  id          String             @id @default(cuid())
  name        String
  affiliateId String? // null = every partner
  affiliate   Affiliate?         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  tourId      String? // null = every tour
  category    TourCategory? // null = every category
  percentBps  Int?
  fixedCents  Int? // per booking, never more than the amount paid
  active      Boolean            @default(true)
  validFrom   DateTime           @default(now())
  validTo     DateTime?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  entries     CommissionLedger[]

  @@index([affiliateId])
}

/// Append-only: amounts are never edited. A refund adds a negative REVERSAL line; corrections are
/// ADJUSTMENT lines. entryKey makes every write idempotent (webhook and job retries).
model CommissionLedger {
  id           String              @id @default(cuid())
  entryKey     String              @unique // EARN:<bookingId> | REFUND:<refundId> | ADJUST:<uuid>
  affiliateId  String
  affiliate    Affiliate           @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  bookingId    String?
  booking      Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  type         CommissionEntryType
  basisCents   Int // amount paid (EARNED) or refunded (REVERSAL) the line was computed on
  amountCents  Int // negative for reversals
  currency     String              @default("CAD")
  ruleId       String?
  rule         CommissionRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleSnapshot Json? // the rule as it stood: {source, percentBps | fixedCents}
  status       CommissionStatus    @default(PENDING)
  payoutId     String?
  payout       AffiliatePayout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  reason       String?
  createdById  String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime            @default(now())

  @@index([affiliateId, status])
  @@index([bookingId])
  @@index([payoutId])
}

/// A payout is prepared and marked paid by an admin; the app never moves money.
model AffiliatePayout {
  id          String             @id @default(cuid())
  affiliateId String
  affiliate   Affiliate          @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  amountCents Int
  currency    String             @default("CAD")
  status      PayoutStatus       @default(DRAFT)
  method      String? // bank transfer, Interac e-Transfer, PayPal…
  reference   String? // the transfer reference staff enter when marking paid
  createdById String?
  paidById    String?
  paidAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  entries     CommissionLedger[]

  @@index([affiliateId, status])
}

/// One row per referral landing, de-duplicated per visitor per day. No raw IP or user agent.
model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  visitorHash String // salted hash of IP + user agent
  landingPath String
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
  @@index([visitorHash, createdAt])
}

// ---------------------------------------------------------------------------------------------
// SEO (docs/SEO.md). Additive: these tables only describe and override page metadata; tours,
// destinations and bookings are never changed by them. Metrics are nullable on purpose: a value we
// have not researched stays null ("unknown") rather than being guessed.

enum SeoPageType {
  HOME
  TOUR // a product page, /<tour slug>
  DESTINATION // /destinations/<slug>
  LANDING // category pages such as /private-tours, /shuttles
  GUIDE // editorial content managed here, /guides/<slug>
  STATIC // about, contact, faq, gallery…
  LEGAL // policies and terms
}

enum SeoPageSource {
  STATIC_ROUTE // a page built in code (frontend/src/app)
  TOUR
  DESTINATION
  CMS // created and rendered from this table (/guides/<slug>)
}

enum SeoPublishStatus {
  DRAFT // overrides saved, not live
  SCHEDULED // goes live at publishAt
  PUBLISHED
  ARCHIVED
}

enum SeoConversionGoal {
  BOOKING
  ENQUIRY
  CALL
  NEWSLETTER
  NONE
}

enum SeoSearchIntent {
  INFORMATIONAL
  COMMERCIAL // commercial investigation
  TRANSACTIONAL
  NAVIGATIONAL
}

enum SeoFunnelStage {
  TOFU
  MOFU
  BOFU
}

enum SeoStrategyTrack {
  TRAFFIC_ACQUISITION // destination guides, planning, sightseeing information
  BOOKING_CONVERSION // tours, shuttles and services Vista Chase actually sells
}

enum SeoPriority {
  HIGH
  MEDIUM
  LOW
}

enum SeoKeywordStatus {
  IDEA
  PLANNED
  IN_PROGRESS
  IMPLEMENTED
  ARCHIVED
}

enum SeoValidationStatus {
  UNVERIFIED // a hypothesis; no keyword tool has confirmed it
  VERIFIED // metrics checked against the named source on lastVerifiedAt
  REJECTED // checked and not worth targeting
}

enum SeoResearchStatus {
  UNVERIFIED // a hypothesis; nobody has researched it yet
  RESEARCHED // metrics looked up in a named tool
  VALIDATED // checked as worth targeting for Vista Chase
  MAPPED // assigned to a page
  IMPLEMENTED // the page targets it
  MONITORED // live and being tracked
}

enum SeoMetricBasis {
  UNKNOWN // no value
  ESTIMATE // a guess or a third-party figure we have not checked
  RESEARCHED // from a named keyword tool, with a date
}

enum SeoMappingRole {
  PRIMARY
  SECONDARY
}

enum SeoIssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SeoIssueStatus {
  OPEN
  IGNORED
  RESOLVED
}

enum SeoAuditTrigger {
  MANUAL
  SCHEDULED
}

enum SeoAuditStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SeoLlmsSection {
  PRIMARY
  SECONDARY
}

/// One row per public URL whose search appearance is managed here. Empty fields fall back to the
/// page's own defaults in code (or the tour / destination record), so a new row changes nothing.
model SeoPage {
  id                 String              @id @default(cuid())
  path               String              @unique // "/", "/private-tours", "/banff-highlights-tour"
  pageType           SeoPageType
  source             SeoPageSource
  tourId             String?             @unique
  tour               Tour?               @relation(fields: [tourId], references: [id], onDelete: SetNull)
  destinationId      String?             @unique
  destination        Destination?        @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  label              String // name shown in the dashboard
  status             SeoPublishStatus    @default(DRAFT)
  publishAt          DateTime?
  publishedAt        DateTime?
  important          Boolean             @default(false) // noindex needs an explicit confirmation
  seoTitle           String?
  metaDescription    String?
  h1                 String?
  focusKeyword       String?
  secondaryKeywords  String[]            @default([])
  canonicalUrl       String?
  robotsIndex        Boolean             @default(true)
  robotsFollow       Boolean             @default(true)
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?
  breadcrumbLabel    String?
  excerpt            String?
  body               String? // CMS pages only: a small markdown subset rendered as text, never HTML
  answerSnippet      String? // TL;DR / direct answer, 40-60 words
  citationFact       String?
  faqs               Json                @default("[]") // [{question, answer}]
  authorName         String?
  authorBio          String?
  reviewedAt         DateTime?
  featuredImage      String?
  featuredImageAlt   String?
  imageTitle         String?
  imageCaption       String?
  imageFileName      String?
  ctaText            String?
  ctaUrl             String?
  conversionGoal     SeoConversionGoal   @default(NONE)
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  pillar             String?
  tags               String[]            @default([])
  relatedPaths       String[]            @default([])
  sitemapPriority    Float?
  lastCrawl          Json? // what the audit saw on the live page: title, description, h1s, canonical…
  lastCrawledAt      DateTime?
  // SEO portal (migration 8): blog posts at /blog-post/<slug>, drafts of live pages, import provenance
  datePublished      DateTime? // original publish date (kept from Webflow); shown and used in BlogPosting
  dateModified       DateTime? // content last changed (kept from Webflow, then bumped by content edits)
  sitemapInclude     Boolean             @default(true) // false = left out of sitemap.xml (page still served)
  featured           Boolean             @default(false) // pinned on the blog landing page
  thumbnailImage     String?
  thumbnailAlt       String?
  // Page settings (migration 9, Webflow-style): site search listing and page-level custom code
  searchTitle        String? // on-site search result title; null = same as the SEO title
  searchDescription  String? // null = same as the meta description
  searchImage        String? // null = same as the Open Graph image
  searchExclude      Boolean             @default(false) // left out of the site search index
  customHeadCode     String? // admin only: allowed tags rendered in <head> (validated on save)
  customBodyCode     String? // admin only: allowed tags rendered before </body>
  draft              Json? // unpublished changes to a live page: {field: value}; applied by "Publish changes"
  draftUpdatedAt     DateTime?
  draftUpdatedById   String?
  importSource       String? // WEBFLOW_API | WEBFLOW_CSV | JSON | MANUAL
  originalUrl        String? // the URL on the old (Webflow) site
  webflowItemId      String?             @unique // Webflow CMS item this blog post is synced from (docs/SEO_PORTAL.md, "Webflow sync")
  webflowSyncedAt    DateTime? // last time the sync wrote this post from Webflow
  webflowHash        String? // fingerprint of the Webflow values last seen, to spot changes
  webflowOfflineAt   DateTime? // set when the sync took the post offline because Webflow unpublished it
  createdById        String?
  updatedById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  revisions          SeoPageRevision[]
  mappings           SeoKeywordMapping[]
  issues             SeoIssue[]

  @@index([pageType])
  @@index([status])
}

/// Append-only change log for a page (content freshness / update log).
model SeoPageRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      SeoPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String?
  action    String // UPDATED, PUBLISHED, UNPUBLISHED, SCHEDULED, ARCHIVED, CREATED
  changes   Json // {field: {from, to}}
  note      String?
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

model SeoKeywordCluster {
  id          String           @id @default(cuid())
  name        String           @unique
  pillar      String?
  track       SeoStrategyTrack
  description String?
  hubPath     String? // the page the cluster points to
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  keywords    SeoKeyword[]
}

model SeoKeyword {
  id                 String              @id @default(cuid())
  ref                Int                 @unique @default(autoincrement()) // human keyword ID, shown as KW-0001
  keyword            String
  normalized         String              @unique // lower-case, single spaces: duplicate detection
  designation        SeoMappingRole      @default(SECONDARY)
  searchVolume       Int?
  volumeBasis        SeoMetricBasis      @default(UNKNOWN)
  volumeSource       String?
  difficulty         Int? // 0-100
  difficultyBasis    SeoMetricBasis      @default(UNKNOWN)
  difficultySource   String?
  intent             SeoSearchIntent
  funnelStage        SeoFunnelStage
  track              SeoStrategyTrack
  clusterId          String?
  cluster            SeoKeywordCluster?  @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  targetPath         String? // planned URL when no page exists yet
  targetPageType     SeoPageType?
  priority           SeoPriority         @default(MEDIUM)
  businessRelevance  Int? // 1-5
  competitionNotes   String?
  competitors        String[]            @default([])
  status             SeoKeywordStatus    @default(IDEA)
  dataSource         String?
  lastVerifiedAt     DateTime?
  validationStatus   SeoValidationStatus @default(UNVERIFIED)
  researchStatus     SeoResearchStatus   @default(UNVERIFIED)
  parentTopic        String?
  market             String              @default("CA") // ISO country code of the search market
  language           String              @default("en")
  bookingIntent      Int? // 1-5: how likely a searcher is to book
  competitorEvidence String? // where the competitor ranking was seen (tool, date, URL)
  contentGap         String?
  recommendedAction  String?
  notes              String?
  archivedAt         DateTime?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  mappings           SeoKeywordMapping[]

  @@index([clusterId])
  @@index([status])
  @@index([track, priority])
  @@index([researchStatus])
}

/// Keyword -> page. A keyword should be PRIMARY on at most one page; the audit flags more
/// (cannibalisation) instead of the database refusing it, so staff can see and fix it.
model SeoKeywordMapping {
  id        String         @id @default(cuid())
  keywordId String
  keyword   SeoKeyword     @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  pageId    String
  page      SeoPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  role      SeoMappingRole @default(SECONDARY)
  createdAt DateTime       @default(now())

  @@unique([keywordId, pageId])
  @@index([pageId])
}

/// 301/308 (permanent) or 302 (temporary) redirects served by the frontend middleware. Only
/// same-site paths: never an external URL, so this can't become an open redirect.
model SeoRedirect {
  id          String   @id @default(cuid())
  fromPath    String   @unique
  toPath      String
  statusCode  Int      @default(301)
  active      Boolean  @default(true)
  source      String   @default("MANUAL") // MANUAL | SLUG_CHANGE | IMPORT
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model SeoAuditRun {
  id          String          @id @default(cuid())
  trigger     SeoAuditTrigger
  status      SeoAuditStatus  @default(RUNNING)
  startedById String?
  baseUrl     String?
  summary     Json            @default("{}")
  error       String?
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  issues      SeoIssue[]

  @@index([startedAt])
}

/// One row per problem; the fingerprint (type + path + detail) keeps the same problem on the same
/// row across audits. Problems an audit no longer finds become RESOLVED; IGNORED stays ignored.
model SeoIssue {
  id            String           @id @default(cuid())
  fingerprint   String           @unique
  type          String
  severity      SeoIssueSeverity
  status        SeoIssueStatus   @default(OPEN)
  path          String?
  pageId        String?
  page          SeoPage?         @relation(fields: [pageId], references: [id], onDelete: SetNull)
  message       String
  detail        Json             @default("{}")
  lastRunId     String?
  lastRun       SeoAuditRun?     @relation(fields: [lastRunId], references: [id], onDelete: SetNull)
  firstSeenAt   DateTime         @default(now())
  lastSeenAt    DateTime         @default(now())
  resolvedAt    DateTime?
  // An audit finding is automated until someone confirms it is a real problem (SEO portal).
  confirmedAt   DateTime?
  confirmedById String?
  note          String?

  @@index([status, severity])
  @@index([pageId])
}

/// Site-wide settings, one row (id "site"): llms.txt header, business details for structured data.
model SeoSiteSettings {
  id                     String   @id @default("site")
  siteName               String   @default("Vista Chase")
  summary                String?
  aboutText              String?
  contactEmail           String?
  contactPhone           String?
  address                String?
  serviceArea            String[] @default([])
  businessHours          String?
  googleBusinessUrl      String?
  sameAs                 String[] @default([])
  llmsEnabled            Boolean  @default(false)
  // SEO portal (migration 8). Each is off / empty by default, so the public site is unchanged until set.
  crawlerRules           Json? // {"GPTBot": "allow" | "block", ...}; absent or "allow" = robots.txt unchanged
  googleSiteVerification String? // meta google-site-verification on the home page (admin-approved)
  tracking               Json? // {enabled, ga4Id, adsId, adsConversionLabel, conversionValue, currency, consentDefault} (admin-approved)
  conversionScript       String? // the Webflow footer script, kept for reference only; never rendered
  updatedById            String?
  updatedAt              DateTime @updatedAt
}

model SeoLlmsEntry {
  id          String         @id @default(cuid())
  title       String
  path        String // same-site path or https URL
  description String?
  section     SeoLlmsSection @default(PRIMARY)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([section, sortOrder])
}

/// Search Console / analytics figures, filled only by a configured provider. Empty until then:
/// the dashboard shows "not connected" rather than any number.
model SeoSearchMetric {
  id          String   @id @default(cuid())
  source      String // "google-search-console"
  path        String
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  query       String?
  fetchedAt   DateTime @default(now())

  @@unique([source, path, date, query])
  @@index([path, date])
}

// ---------------------------------------------------------------------------------------------
// Staff follow-ups on a booking (docs/ADMIN.md): payments that didn't match or came late, refunds
// owed after a staff cancellation, Quick Book bookings still to be paid. Open until staff resolve them.

enum BookingFlagType {
  PAYMENT_AMOUNT_MISMATCH
  LATE_PAYMENT
  REFUND_DUE
  PAYMENT_DUE
  CANCEL_REQUEST // guest asked to cancel from My trips; staff approve or decline
  OTHER
}

enum BookingFlagStatus {
  OPEN
  RESOLVED
}

model BookingFlag {
  id           String            @id @default(cuid())
  bookingId    String
  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type         BookingFlagType
  status       BookingFlagStatus @default(OPEN)
  note         String
  amountCents  Int? // refund owed or payment due, when the flag is about money
  createdById  String? // staff member who raised it; null when the system did
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime          @default(now())

  @@index([status, type])
  @@index([bookingId])
}

// ---------------------------------------------------------------------------------------------
// SEO portal (/seo, docs/SEO_PORTAL.md): schema drafts, tasks, the migration checklist, approvals,
// imports and the live-site baseline. Migration 8_seo_portal (additive).

enum SeoSchemaScope {
  SITE // rendered on every page (replaces the coded block with the same @id)
  PAGE // one page (CMS pages: guides and blog posts)
}

enum SeoSchemaStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// JSON-LD managed in the portal. `json` is the published version; `draftJson` is being edited.
model SeoSchemaBlock {
  id          String          @id @default(cuid())
  scope       SeoSchemaScope
  pageId      String?
  name        String
  schemaType  String // "@type" of the block, for listing
  json        Json? // published
  draftJson   Json?
  status      SeoSchemaStatus @default(DRAFT)
  validation  Json            @default("[]")
  publishedAt DateTime?
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([scope, status])
  @@index([pageId])
}

enum SeoTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model SeoTask {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      SeoTaskStatus @default(TODO)
  priority    SeoPriority   @default(MEDIUM)
  category    String? // e.g. Metadata, Blog, Redirects, Images, Schema, Technical
  assigneeId  String?
  dueDate     DateTime?
  path        String?
  keywordId   String?
  issueId     String?
  createdById String?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([assigneeId])
}

enum SeoChecklistPhase {
  BEFORE_LAUNCH
  AFTER_LAUNCH
}

enum SeoChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
  NOT_APPLICABLE
}

/// The Webflow → custom site migration checklist. DONE needs evidence or a recorded confirmation.
model SeoChecklistItem {
  id            String             @id @default(cuid())
  key           String             @unique
  phase         SeoChecklistPhase
  section       String
  title         String
  description   String?
  source        String             @default("HANDOFF") // HANDOFF | STANDARD
  sortOrder     Int                @default(0)
  status        SeoChecklistStatus @default(NOT_STARTED)
  notes         String?
  assigneeName  String?
  evidence      String[]           @default([])
  confirmedById String?
  confirmedAt   DateTime?
  autoCheck     String? // key of the automated check that gives evidence
  lastCheck     Json? // {ok, message, at}
  updatedById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([phase, sortOrder])
}

enum SeoChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A change only an admin may make (tracking tags, site verification, site-wide JSON-LD). An SEO
/// manager requests it; an admin approves (which applies it) or rejects it.
model SeoChangeRequest {
  id            String                 @id @default(cuid())
  kind          String // TRACKING | VERIFICATION | SITE_SCHEMA
  targetId      String?
  title         String
  payload       Json
  before        Json?
  reason        String?
  status        SeoChangeRequestStatus @default(PENDING)
  requestedById String?
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, createdAt])
}

/// One import (Webflow API, CSV or JSON): the original data is kept as the migration record.
model SeoImportBatch {
  id          String    @id @default(cuid())
  kind        String // BLOG_POSTS | PAGE_METADATA | REDIRECTS
  source      String // WEBFLOW_API | CSV | JSON
  status      String    @default("PREVIEWED") // PREVIEWED | APPLIED | DISCARDED
  fileName    String?
  raw         Json // the export as received (items normalised to plain objects)
  preview     Json      @default("{}")
  result      Json?
  createdById String?
  appliedById String?
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([kind, createdAt])
}

/// A URL of the live site before migration (crawled from its sitemap, or from an uploaded crawl).
model SeoBaselineUrl {
  id          String   @id @default(cuid())
  batchId     String
  url         String
  path        String
  statusCode  Int?
  redirectTo  String?
  title       String?
  description String?
  canonical   String?
  h1          String[] @default([])
  robots      String?
  ogTitle     String?
  ogImage     String?
  source      String   @default("CRAWL") // CRAWL | UPLOAD
  crawledAt   DateTime @default(now())

  @@unique([batchId, path])
  @@index([path])
}
