# ==============================================================================
# Vista Chase Backend (Express API) - Environment Configuration
# ==============================================================================

NODE_ENV=development
PORT=4000
JWT_SECRET=super-secret-jwt-token-vista-chase-rockies-2026-development-only

# Public URL of the frontend (used in email links and as the default CORS origin)
FRONTEND_URL=http://localhost:3000
# Optional comma-separated list of extra origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000

# Database: PostgreSQL (migrations in prisma/migrations; `npx prisma migrate deploy`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vistachase?schema=public"
# Tests reset and seed this database; its name must contain "test" (tests/test-database-url.ts)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vistachase_test?schema=public"

# CACHE_PROVIDER: memory | redis
CACHE_PROVIDER=memory
REDIS_URL="redis://localhost:6379"

# STORAGE_PROVIDER: local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR="./public/uploads"
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=vistachase-media

# EMAIL_PROVIDER: console | resend | ses
EMAIL_PROVIDER=console
EMAIL_FROM="Vista Chase Bookings <bookings@vistachase.com>"
RESEND_API_KEY=

# PAYMENT_PROVIDER: mock | stripe. Production needs stripe; the mock pays instantly (dev only).
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook pointing at <api>/api/webhooks/stripe (required for Stripe)
STRIPE_WEBHOOK_SECRET=
# Promo codes as CODE:percent pairs. TESTVISTA100 works only outside production.
PROMO_CODES="RIMROCKBANFF5:5,BANFF10:10"

# Signs voucher, check-in and review links (falls back to JWT_SECRET). Must match on API and worker.
VOUCHER_SECRET=

# Team inbox for enquiries, and who receives the nightly "bookings needing attention" email
ENQUIRIES_TO=info@vistachase.com
OPS_ALERT_EMAIL=

# Error tracking (optional)
SENTRY_DSN=

# AI concierge. With ANTHROPIC_API_KEY set, the concierge is a Claude agent with web search and
# the booking tools (src/lib/ai/concierge.agent.ts); without it, the scripted assistant answers.
ANTHROPIC_API_KEY=
# Optional model override (default claude-sonnet-5-5)
ANTHROPIC_MODEL=

# AI_VOICE_PROVIDER: mock | gemini | openai (scripted fallback when no Anthropic key is set)
AI_VOICE_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# MAPS_PROVIDER: mock | google | mapbox
MAPS_PROVIDER=mock

# Run the 5-min hold expiry inside the API (no worker, e.g. Render free).
RUN_JOBS_IN_API=false

# Site images (backend/media, served at /media). Defaults to ./media.
# MEDIA_DIR=./media

# Admin Initial Credentials (for seeding)
ADMIN_EMAIL=admin@vistachase.com
ADMIN_PASSWORD=VistaChaseAdmin2026!
