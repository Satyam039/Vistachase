# ==============================================================================
# Vista Chase - Environment Configuration
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=super-secret-jwt-token-vista-chase-rockies-2026-development-only

# Provider Selection (Easily swap between Local/Free & Production/AWS)
# DB_PROVIDER: prisma-postgres | prisma-sqlite
DB_PROVIDER=prisma-postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vistachase?schema=public"

# CACHE_PROVIDER: memory | redis
CACHE_PROVIDER=memory
REDIS_URL="redis://localhost:6379"

# STORAGE_PROVIDER: local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR="./public/uploads"
# AWS S3 (when ready for migration)
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=vistachase-media

# EMAIL_PROVIDER: console | resend | ses
EMAIL_PROVIDER=console
EMAIL_FROM="Vista Chase Bookings <bookings@vistachase.com>"
RESEND_API_KEY=

# PAYMENT_PROVIDER: mock | stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI_VOICE_PROVIDER: mock | gemini | openai
AI_VOICE_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# MAPS_PROVIDER: mock | google | mapbox
MAPS_PROVIDER=mock
NEXT_PUBLIC_MAPS_API_KEY=

# Admin Initial Credentials (for seeding)
ADMIN_EMAIL=admin@vistachase.com
ADMIN_PASSWORD=VistaChaseAdmin2026!
